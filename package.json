{
  "name": "professional-resume-template---lekan-koku",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787 --var ACCESS_DISABLED:true",
    "db:migrate:local": "wrangler d1 migrations apply resume-builder --local",
    "db:migrate:remote": "wrangler d1 migrations apply resume-builder --remote",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p worker",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "lucide-react": "0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "5.0.5",
    "wrangler": "^4.152.0"
  }
}
