{
	"name": "resume-builder",
	"compatibility_date": "2026-01-06",
	"main": "worker/index.ts",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "resume-builder",
			"database_id": "2a0c6d5e-4d4a-41f3-907c-d10e02e4a081",
			"migrations_dir": "migrations"
		},
		{
			"binding": "resume_builder",
			"database_name": "resume-builder",
			"database_id": "2a0c6d5e-4d4a-41f3-907c-d10e02e4a081"
		}
	],
	"r2_buckets": [
		{
			"binding": "DOCUMENTS",
			"bucket_name": "resume-builder-documents"
		}
	],
	"vars": {
		"ACCESS_TEAM_DOMAIN": "dot24labs.cloudflareaccess.com",
		"ACCESS_AUD": "7f74802e55c22b6500076decfa3c07a7186c05c8a5751c1741c42727e0f96001",
		"LLM_PROVIDER": "openai",
		"LLM_MODEL": "gpt-6-astra",
		"LLM_REASONING_EFFORT": "medium",
		"LLM_PRICE_INPUT_PER_M": "10",
		"LLM_PRICE_CACHED_INPUT_PER_M": "1",
		"LLM_PRICE_OUTPUT_PER_M": "50"
	}
}
