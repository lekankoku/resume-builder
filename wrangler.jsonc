{
	"name": "resume-builder",
	"compatibility_date": "2026-01-06",
	"main": "worker/index.ts",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "resume-builder",
			"database_id": "2a0c6d5e-4d4a-41f3-907c-d10e02e4a081",
			"migrations_dir": "migrations"
		},
		{
			"binding": "resume_builder",
			"database_name": "resume-builder",
			"database_id": "2a0c6d5e-4d4a-41f3-907c-d10e02e4a081"
		}
	],
	"r2_buckets": [
		{
			"binding": "DOCUMENTS",
			"bucket_name": "resume-builder-documents"
		}
	],
	"vars": {
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": "",
		"ACCESS_DISABLED": "true"
	}
}
